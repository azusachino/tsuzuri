{
  "name": "tsuzuri",
  "version": "0.7.0",
  "description": "An SDK and CLI for reading and capturing into an Obsidian-compatible Markdown vault",
  "type": "module",
  "module": "./dist/lib/index.js",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./tools": {
      "bun": "./src/tools.ts",
      "types": "./dist/lib/tools.d.ts",
      "default": "./dist/lib/tools.js"
    },
    "./extension": {
      "bun": "./src/extension.ts",
      "types": "./dist/lib/extension.d.ts",
      "default": "./dist/lib/extension.js"
    },
    "./extensions/journal": {
      "bun": "./src/extensions/journal.ts",
      "types": "./dist/lib/extensions/journal.d.ts",
      "default": "./dist/lib/extensions/journal.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tsuzuri": "./dist/lib/cli.js",
    "tsuzuri-tools": "./dist/lib/tools-cli.js"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --maxWorkers=4",
    "build": "npm run build:lib",
    "build:lib": "rm -rf dist/lib && tsc -p tsconfig.build.json",
    "prepack": "npm run build:lib"
  },
  "dependencies": {
    "diff": "9.0.0",
    "ignore": "7.0.9",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azusachino/tsuzuri.git"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "notes",
    "cli",
    "sdk",
    "bun",
    "agent",
    "tools",
    "mcp"
  ],
  "types": "./dist/lib/index.d.ts",
  "files": [
    "dist/lib",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/azusachino/tsuzuri#readme",
  "bugs": {
    "url": "https://github.com/azusachino/tsuzuri/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
